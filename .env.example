# =============================================================================
# LingoPeak — Production & Development Environment Variable Specification
# =============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env' for local development:
#    cp .env.example .env
# 2. Fill in the required values below.
# 3. NEVER commit your actual '.env' file or any private keys/tokens to Git.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. BACKEND RUNTIME CONFIGURATION (Express / Node.js)
# -----------------------------------------------------------------------------
# Port where the HTTP Express server listens (Default: 3000)
PORT=3000

# Environment mode: 'development' | 'production' | 'test'
# - development: Launches Vite in middleware mode for hot module replacement (HMR)
# - production: Serves pre-built static assets from dist/ with SPA client routing
NODE_ENV=development

# Canonical public base URL of the deployed application
# Used for OAuth callbacks, CORS validation, and self-referential links
APP_URL=http://localhost:3000

# Allowed CORS Origins (comma-separated for multiple domains)
# Example: https://lingopeak.web.app,https://lingopeak.firebaseapp.com
# Default: '*' in development
CORS_ORIGIN=http://localhost:3000

# Google Gemini API Key (Secret - Backend Only)
# Required for live AI conversation tutor, essay feedback, and question bank QA.
# Note: If omitted, the server operates safely in pedagogical rule-based offline fallback mode.
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Web API Key for backend token verification via Google Identity Toolkit
# (Optional: If omitted, falls back to VITE_FIREBASE_API_KEY for development)
FIREBASE_API_KEY=your_firebase_web_api_key_here

# -----------------------------------------------------------------------------
# 2. FRONTEND CLIENT CONFIGURATION (Vite Client-Side)
# -----------------------------------------------------------------------------
# WARNING: All variables prefixed with 'VITE_' are bundled directly into the
# client JavaScript application and are PUBLICLY VISIBLE in the browser.
# DO NOT put server secrets, private keys, or admin tokens in VITE_* variables!
# -----------------------------------------------------------------------------
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_API_KEY=your_public_client_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_firebase_project_id.firebaseapp.com
VITE_FIREBASE_DATABASE_ID=your_firestore_database_id
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_web_app_id
